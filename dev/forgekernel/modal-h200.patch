+"""The canonical O projection's M=32 b2o route, with untimed immutable-weight preparation."""
+import weakref
+import submission as _mod
+
+_cache = {}
+
+def run(x, weight):
+    key = id(weight)
+    version = weight._version
+    entry = _cache.get(key)
+    if entry is None or entry[0]() is not weight or entry[1] != version:
+        state = _mod.b2o_prepare_olayer_candidates({'o': weight}, [(32, 128, 8, 1, 1, 1)])
+        entry = (weakref.ref(weight), version, state)
+        _cache[key] = entry
+    return _mod.b2o_run_olayer_candidate(x, entry[2], 0)
