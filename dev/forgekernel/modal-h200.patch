+                sp = plan_fn(ext,ids,packs,streams,weights[key[0]],key[0],key,chosen,cfg)
+            if sp is not None:
+                st['plans'][key] = dict(sp,ext=ext,family=family,inst=chosen,depth=depth)
+    return st
