+def v18d_v18d_native_geometry(R, C, rt, wr, wk, ku, s):
+    if R % (wr * rt) or C != s * wk * ku:
+        return None
+    gx = R // (wr * rt)
+    return (gx, wr * wk, gx * s * wr * wk)
