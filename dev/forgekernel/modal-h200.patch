+    out = torch.empty((m,n),dtype=torch.float32 if layer == 'router' else torch.bfloat16,device=x.device)
+    rc = cps_launch(sp,x,out,n,st.get('policy',0))
+    if rc:
+        raise RuntimeError(f'cpstage launch failed: {rc}')
+    return out
+
