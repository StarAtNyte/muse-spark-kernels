+def cps_launch(sp, x, out, n, policy=0, query=0):
+    fn = cps32_launch_raw if sp['family'] == 'm32' else cpssm_launch_raw
+    return fn(sp['ext'],sp['inst_id'],sp,x,out,n,sp['cfg'],query+policy*100)
