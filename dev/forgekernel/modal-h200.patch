+QKV_SM_SIGN_POS = (3, 19, 7, 23, 11, 27, 15, 31)
+QKV_SM_LAYER_K = {"qkv_gate": 8192, "o": 1024, "pooler": 8192, "unpooler": 4096, "router": 8192}
+QKV_SM_ESC_CAP = 32
