+extern "C" void wm_route_c(const int* ids, int npair, const int* ls_ptr, int ls_val, int lmax, int* cnt, int* lst,
+                           int* act, int* nact, int* local_ids, int* woff, int grp, int nslots, cudaStream_t st) {
