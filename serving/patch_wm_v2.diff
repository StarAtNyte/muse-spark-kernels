+
+// bit sources of the four code bits (m0, m1, m2, sign) for register j = rh + 2 p, low half (the high half is +16)
+__constant__ int c_src[4][4] = {{6, 7, 8, 15}, {9, 10, 11, 18}, {12, 13, 14, 21}, {4, 0, 1, 3}};
+
+__device__ __forceinline__ int wm_pos(int j, int bit, int h) { return (c_src[j][bit] + 16 * h) & 31; }
+
+// e4m3 scale -> b' with bf16 bits of S * 2^118 == (b' << 4) + 0x7600 (clamped at the smallest e4m3 subnormal)
+__device__ __forceinline__ uint8_t s2bp(uint8_t s8) {
+  const int sign_exp = s8 & 0x7F;                       // scales are non-negative
+  float f;
+  {
+    const int e = (sign_exp >> 3) & 15, m = sign_exp & 7;
+    f = e == 0 ? (m * 0.001953125f) : (1.0f + m * 0.125f) * __int_as_float((e - 7 + 127) << 23);
+  }
+  f *= __int_as_float((118 + 127) << 23);               // 2^118
+  int bits = __float_as_uint(f) >> 16;
+  if (bits < 0x7600) bits = 0x7600;
+  return (uint8_t)((bits - 0x7600) >> 4);
+}
+
+// raw: uint8 [E, R, K/2] (low nibble = even k), sf: e4m3 [E, R, K/16]  ->  words int32 [E, RTn, KCn, 32, 4], scales uint8 [E, RTn, KCn/4, 32, 8]
+__global__ void raw_to_wm_w(const uint8_t* __restrict__ raw, uint32_t* __restrict__ out, int R, int K) {
+  const long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;
+  const int RTn = R / 16, KCn = K / 64;
+  const long total = (long)gridDim.y * RTn * KCn * 128;
+  if (idx >= total) return;
+  const int ks = idx & 3, lane = (idx >> 2) & 31;
+  long r = idx >> 7;
+  const int kc = r % KCn; r /= KCn;
+  const int rt = r % RTn;
+  const int e = blockIdx.y;
+  const int g = lane >> 2, t = lane & 3;
+  uint32_t word = 0;
+#pragma unroll
+  for (int rh = 0; rh < 2; rh++)
+#pragma unroll
+    for (int p = 0; p < 2; p++)
+#pragma unroll
+      for (int h = 0; h < 2; h++) {
+        const int row = rt * 16 + rh * 8 + g;
+        const int k = kc * 64 + t * 16 + ks * 4 + p * 2 + h;
+        const uint8_t byte = raw[((size_t)e * R + row) * (K / 2) + (k >> 1)];
+        const uint32_t code = (k & 1) ? (byte >> 4) : (byte & 15);
+        const int j = rh + 2 * p;
+#pragma unroll
+        for (int bit = 0; bit < 4; bit++) word |= ((code >> bit) & 1u) << wm_pos(j, bit, h);
+      }
+  out[(((size_t)e * RTn + rt) * KCn + kc) * 128 + lane * 4 + ks] = word;
+}
+
+__global__ void raw_to_wm_s(const uint8_t* __restrict__ sf, uint8_t* __restrict__ out, int R, int K) {
+  const long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;
+  const int RTn = R / 16, KCn = K / 64, KGn = K / 16;
+  const long total = (long)gridDim.y * RTn * (KCn / 4) * 256;
+  if (idx >= total) return;
+  const int b = idx & 7, lane = (idx >> 3) & 31;
+  long r = idx >> 8;
+  const int kcg = r % (KCn / 4); r /= (KCn / 4);
+  const int rt = r % RTn;
+  const int e = blockIdx.y;
+  const int rh = b >> 2, c = b & 3, g = lane >> 2, t = lane & 3;
+  const int row = rt * 16 + rh * 8 + g, grp = kcg * 16 + c * 4 + t;
+  out[(size_t)e * RTn * (KCn / 4) * 256 + ((((size_t)rt * (KCn / 4) + kcg) * 32 + lane) * 8 + b)] = s2bp(sf[((size_t)e * R + row) * KGn + grp]);
+}
+
+// wm -> Marlin: words int32 [E, K/16, N/64*128], scales uint8 [E, K/16, N]
+__global__ void wm_to_marlin_w(const uint32_t* __restrict__ wm, uint32_t* __restrict__ out, int N, int K) {
+  const long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;      // output word index within the expert
+  const long per = (long)(K / 16) * (N / 64) * 128;
+  if (idx >= per) return;
+  const int RTn = N / 16, KCn = K / 64;
+  const int e = blockIdx.y;
+  const int wq = idx & 3, lane = (idx >> 2) & 31;
+  long r = idx >> 7;
+  const int nt = r % (N / 64); r /= (N / 64);
+  const int kt = (int)r;
+  const int g = lane >> 2, tq = lane & 3;
+  uint32_t res = 0;
+#pragma unroll
+  for (int i = 0; i < 8; i++) {
+    const int kl = i >> 2, hn = (i >> 1) & 1, kh = i & 1;
+    const int n = nt * 64 + wq * 16 + hn * 8 + g;
+    const int k = kt * 16 + kh * 8 + tq * 2 + kl;
+    const int rt = n >> 4, rh = (n >> 3) & 1, gg = n & 7;
+    const int kc = k >> 6, rr = k & 63;
+    const int t = rr >> 4, ks = (rr & 15) >> 2, p = (rr & 3) >> 1, h = rr & 1;
+    const uint32_t w = wm[(((size_t)e * RTn + rt) * KCn + kc) * 128 + (gg * 4 + t) * 4 + ks];
+    const int j = rh + 2 * p;
+    uint32_t code = 0;
+#pragma unroll
+    for (int bit = 0; bit < 4; bit++) code |= ((w >> wm_pos(j, bit, h)) & 1u) << bit;
+    res |= code << (4 * i);
+  }
+  out[(size_t)e * per + idx] = res;
+}
+
+__global__ void wm_to_marlin_s(const uint8_t* __restrict__ wms, uint8_t* __restrict__ out, int N, int K) {
+  const long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;      // (kg, pos) within the expert
+  const long per = (long)(K / 16) * N;
+  if (idx >= per) return;
+  const int RTn = N / 16, KCn = K / 64;
+  const int e = blockIdx.y;
+  const int kg = idx / N, pos = idx % N;
+  const int blk = pos >> 6, p = pos & 63;
+  const int p0 = (p & ~3) | ((p & 3) == 1 ? 2 : (p & 3) == 2 ? 1 : (p & 3));   // swap of the middle pair of each 4
+  const int nl = (p0 >> 3) + 8 * (p0 & 7);
+  const int n = blk * 64 + nl;
+  const int rt = n >> 4, rh = (n >> 3) & 1, g = n & 7;
+  const int kcg = kg >> 4, c = (kg >> 2) & 3, t = kg & 3;
+  const uint8_t bp = wms[(size_t)e * RTn * (KCn / 4) * 256 + ((((size_t)rt * (KCn / 4) + kcg) * 32 + (g * 4 + t)) * 8 + rh * 4 + c)];
+  out[(size_t)e * per + idx] = (uint8_t)(bp + 104);
+}
+
+extern "C" void conv_raw_to_wm(const void* raw_w, const void* sf, void* out_w, void* out_s, int E, int R, int K, cudaStream_t st) {
+  {
+    const long total = (long)(R / 16) * (K / 64) * 128;
+    dim3 grid((total + 255) / 256, E);
+    raw_to_wm_w<<<grid, 256, 0, st>>>(reinterpret_cast<const uint8_t*>(raw_w), reinterpret_cast<uint32_t*>(out_w), R, K);
+  }
+  {
+    const long total = (long)(R / 16) * (K / 256) * 256;
+    dim3 grid((total + 255) / 256, E);
+    raw_to_wm_s<<<grid, 256, 0, st>>>(reinterpret_cast<const uint8_t*>(sf), reinterpret_cast<uint8_t*>(out_s), R, K);
+  }
+}
+
+extern "C" void conv_wm_to_marlin(const void* wm_w, const void* wm_s, void* out_w, void* out_s, int E, int N, int K, cudaStream_t st) {
+  {
+    const long per = (long)(K / 16) * (N / 64) * 128;
+    dim3 grid((per + 255) / 256, E);
+    wm_to_marlin_w<<<grid, 256, 0, st>>>(reinterpret_cast<const uint32_t*>(wm_w), reinterpret_cast<uint32_t*>(out_w), N, K);
+  }
+  {
+    const long per = (long)(K / 16) * N;
+    dim3 grid((per + 255) / 256, E);
+    wm_to_marlin_s<<<grid, 256, 0, st>>>(reinterpret_cast<const uint8_t*>(wm_s), reinterpret_cast<uint8_t*>(out_s), N, K);
+  }
+}
+
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+extern "C" void wm_route_c(const int*, int, const int*, int, int, int*, int*, int*, int*, int*, int*, int, int, cudaStream_t);
+extern "C" void wm_set_pdl(int);
+void wm_set_pdl_t(int64_t v) { wm_set_pdl((int)v); }
+extern "C" void wm_set_persist(int);
+void wm_set_persist_t(int64_t v) { wm_set_persist((int)v); }
+extern "C" void wm_finish_c(const void*, const float*, const int*, const void*, void*, int, float, cudaStream_t);
+void wm_finish(torch::Tensor y, torch::Tensor tw, torch::Tensor lids, torch::Tensor nw, torch::Tensor out, double eps) {
+  wm_finish_c(y.data_ptr(), tw.data_ptr<float>(), lids.data_ptr<int>(), nw.data_ptr(), out.data_ptr(), (int)out.size(0), (float)eps,
+              at::cuda::getCurrentCUDAStream());
+}
+extern "C" void wm_permx_c(const void*, void*, int, cudaStream_t);
+void wm_permx(torch::Tensor x, torch::Tensor xp) { wm_permx_c(x.data_ptr(), xp.data_ptr(), (int)x.size(0), at::cuda::getCurrentCUDAStream()); }
+extern "C" int wm_gemm_c(int, int, int, int, int, int, const void*, const void*, const float*, const void*, void*, const int*,
+                         const int*, const int*, const int*, const int*, int, int, cudaStream_t);
+
+void wm_route(torch::Tensor ids, torch::Tensor ls, int64_t ls_val, int64_t lmax, torch::Tensor cnt, torch::Tensor lst,
+              torch::Tensor act, torch::Tensor nact, torch::Tensor local_ids, torch::Tensor woff, int64_t grp) {
+  wm_route_c(ids.data_ptr<int>(), (int)ids.numel(), ls.numel() ? ls.data_ptr<int>() : nullptr, (int)ls_val, (int)lmax, cnt.data_ptr<int>(),
+             lst.data_ptr<int>(), act.data_ptr<int>(), nact.data_ptr<int>(), local_ids.data_ptr<int>(), woff.data_ptr<int>(), (int)grp,
+             (int)(act.numel() / 4), at::cuda::getCurrentCUDAStream());
+}
+
+void wm_gemm_run(int64_t mode, int64_t nmax, int64_t nt, int64_t nw, int64_t ring, int64_t dbg, torch::Tensor W, torch::Tensor S, torch::Tensor GS, torch::Tensor X,
+                 torch::Tensor OUT, torch::Tensor cnt, torch::Tensor lst, torch::Tensor act, torch::Tensor nact,
+                 torch::Tensor woff, int64_t maxslots, int64_t lmax) {
+  int r = wm_gemm_c((int)mode, (int)nmax, (int)nt, (int)nw, (int)ring, (int)dbg, W.data_ptr(), S.data_ptr(), GS.data_ptr<float>(), X.data_ptr(),
+                    OUT.data_ptr(), cnt.data_ptr<int>(), lst.data_ptr<int>(), act.data_ptr<int>(),
+                    nact.data_ptr<int>(), woff.data_ptr<int>(), (int)maxslots, (int)lmax, at::cuda::getCurrentCUDAStream());
+  TORCH_CHECK(r == 0, "unsupported config");
+}
+
+extern "C" void conv_raw_to_wm(const void*, const void*, void*, void*, int, int, int, cudaStream_t);
+extern "C" void conv_wm_to_marlin(const void*, const void*, void*, void*, int, int, int, cudaStream_t);
+void conv_raw_to_wm_t(torch::Tensor raw, torch::Tensor sf, torch::Tensor out_w, torch::Tensor out_s) {
+  conv_raw_to_wm(raw.data_ptr(), sf.data_ptr(), out_w.data_ptr(), out_s.data_ptr(), (int)raw.size(0), (int)raw.size(1), (int)raw.size(2) * 2,
+                 at::cuda::getCurrentCUDAStream());
+}
+void conv_wm_to_marlin_t(torch::Tensor wm_w, torch::Tensor wm_s, torch::Tensor out_w, torch::Tensor out_s, int64_t N, int64_t K) {
+  conv_wm_to_marlin(wm_w.data_ptr(), wm_s.data_ptr(), out_w.data_ptr(), out_s.data_ptr(), (int)wm_w.size(0), (int)N, (int)K,
+                    at::cuda::getCurrentCUDAStream());
+}
+'''
+_CPP_SRC = r'''
+void wm_set_pdl_t(int64_t v);
+void wm_set_persist_t(int64_t v);
+void wm_permx(torch::Tensor x, torch::Tensor xp);
+void wm_finish(torch::Tensor y, torch::Tensor tw, torch::Tensor lids, torch::Tensor nw, torch::Tensor out, double eps);
+void wm_route(torch::Tensor ids, torch::Tensor ls, int64_t ls_val, int64_t lmax, torch::Tensor cnt, torch::Tensor lst,
+              torch::Tensor act, torch::Tensor nact, torch::Tensor local_ids, torch::Tensor woff, int64_t grp);
+void wm_gemm_run(int64_t mode, int64_t nmax, int64_t nt, int64_t nw, int64_t ring, int64_t dbg, torch::Tensor W, torch::Tensor S, torch::Tensor GS, torch::Tensor X,
+                 torch::Tensor OUT, torch::Tensor cnt, torch::Tensor lst, torch::Tensor act, torch::Tensor nact,
+                 torch::Tensor woff, int64_t maxslots, int64_t lmax);
+
+void conv_raw_to_wm_t(torch::Tensor raw, torch::Tensor sf, torch::Tensor out_w, torch::Tensor out_s);
+void conv_wm_to_marlin_t(torch::Tensor wm_w, torch::Tensor wm_s, torch::Tensor out_w, torch::Tensor out_s, int64_t N, int64_t K);
+'''
+
+_module = None
+_module_lock = threading.Lock()
+_scratch = None
+_empty_i32 = None
+
+
+def _get_module():
+    global _module
+    if _module is None:
+        with _module_lock:
+            if _module is None:
+                import os
+
+                from torch.utils.cpp_extension import load_inline
+
+                last_error = None
+                for build_dir in (None, "/tmp/muse_wm_experts_build"):   # the default cache may be read-only in a container
+                    try:
+                        if build_dir is not None:
+                            os.makedirs(build_dir, exist_ok=True)
+                        mod = load_inline(
+                            "muse_wm_experts_v1",
+                            _CPP_SRC,
+                            cuda_sources=_CUDA_SRC,
+                            functions=["wm_route", "wm_gemm_run", "wm_set_pdl_t", "wm_permx", "conv_raw_to_wm_t", "conv_wm_to_marlin_t"],
+                            extra_cuda_cflags=["-O3", "--use_fast_math", "-gencode=arch=compute_90,code=sm_90"],
+                            build_directory=build_dir,
+                            verbose=False,
+                        )
+                        break
+                    except Exception as error:  # noqa: BLE001
+                        last_error = error
+                else:
+                    raise last_error
+                mod.wm_set_pdl_t(1)
+                _module = mod
+    return _module
+
+
+# (max tokens) -> (tiles per CTA, warps per CTA, ring variant, 8-token groups per work item); chosen on the H200 for the kernel benchmark (batch sizes 1..256)
+_CFG = [(1, (2, 4, 0, 1)), (8, (2, 2, 0, 1)), (16, (2, 4, 0, 2)), (32, (4, 4, 1, 4)), (10**9, (4, 4, 4, 4))]
+
+
+def _cfg(m: int):
+    for bound, cfg in _CFG:
+        if m <= bound:
+            return cfg
+    return _CFG[-1][1]
+
+
+def supports(layer) -> bool:
+    """The wm path is written for this model's expert shape under 8-way expert parallelism on SM90."""
+    return (
+        torch.cuda.is_available()
+        and torch.cuda.get_device_capability()[0] == _SM_MAJOR
+        and layer.num_local_experts == _NUM_LOCAL
+        and layer.global_num_experts == 256
+        and layer.hidden_size == _HIDDEN
+        and layer.intermediate_size_per_partition == _INTER
+        and layer.top_k == _TOP_K
+    )
+
+
+def _process_global_scale(gs: torch.Tensor) -> torch.Tensor:
+    """gs * 2^119 in bf16, as nvfp4_marlin_process_global_scale does for bfloat16 activations."""
+    return (gs.to(torch.bfloat16) * (2.0 ** 119)).contiguous()
+
+
+class WmExperts:
+    """Weight-major copies of one layer's experts plus the small tensors Marlin needs to be fed on demand."""
+
+    def __init__(self, w13, s13, w2, s2, gs13_marlin, gs2_marlin):
+        self.w13, self.s13, self.w2, self.s2 = w13, s13, w2, s2
+        self.gs13_marlin, self.gs2_marlin = gs13_marlin, gs2_marlin    # bf16 [32], as Marlin expects them
+        self.gs13 = (gs13_marlin.float() * (2.0 ** -119)).contiguous()  # exact power-of-two rescale back to the real scale
+        self.gs2 = (gs2_marlin.float() * (2.0 ** -119)).contiguous()
+
+
+def build_wm_experts(w13_raw, w13_sf, w13_gs, w2_raw, w2_sf, w2_gs) -> WmExperts:
+    """raw HF-layout NVFP4 tensors of one layer's local experts -> weight-major layout (does not free the inputs)."""
+    mod = _get_module()
+    dev = w13_raw.device
+    E, R13, K2 = w13_raw.shape
+    out13 = torch.empty((E, R13 // 16, K2 * 2 // 64, 32, 4), dtype=torch.int32, device=dev)
+    s13 = torch.empty((E, R13 // 16, K2 * 2 // 256, 32, 8), dtype=torch.uint8, device=dev)
+    mod.conv_raw_to_wm_t(w13_raw.contiguous(), w13_sf.contiguous().view(torch.uint8), out13, s13)
+    E2, R2, K22 = w2_raw.shape
+    out2 = torch.empty((E2, R2 // 16, K22 * 2 // 64, 32, 4), dtype=torch.int32, device=dev)
+    s2 = torch.empty((E2, R2 // 16, K22 * 2 // 256, 32, 8), dtype=torch.uint8, device=dev)
+    mod.conv_raw_to_wm_t(w2_raw.contiguous(), w2_sf.contiguous().view(torch.uint8), out2, s2)
+    return WmExperts(out13, s13, out2, s2, _process_global_scale(w13_gs), _process_global_scale(w2_gs))
+
+
+class _Scratch:
+    """One Marlin-layout copy of an expert bank, shared by every layer (layers run one after the other on a stream)."""
+
+    def __init__(self, device):
+        k16 = _HIDDEN // 16
+        self.w13 = torch.empty((_NUM_LOCAL, k16, 2 * _INTER // 64 * 128), dtype=torch.int32, device=device)
+        self.s13 = torch.empty((_NUM_LOCAL, k16, 2 * _INTER), dtype=torch.float8_e4m3fn, device=device)
+        self.w2 = torch.empty((_NUM_LOCAL, _INTER // 16, _HIDDEN // 64 * 128), dtype=torch.int32, device=device)
+        self.s2 = torch.empty((_NUM_LOCAL, _INTER // 16, _HIDDEN), dtype=torch.float8_e4m3fn, device=device)
+
+
+def reserve_scratch(device) -> None:
+    global _scratch
+    if _scratch is None:
+        _scratch = _Scratch(device)
+
+
+def marlin_view(wm: WmExperts):
+    """Convert one layer's weights into the shared Marlin scratch; returns (w13, s13, gs13, w2, s2, gs2)."""
+    mod = _get_module()
+    reserve_scratch(wm.w13.device)
+    sc = _scratch
+    mod.conv_wm_to_marlin_t(wm.w13, wm.s13, sc.w13, sc.s13.view(torch.uint8), 2 * _INTER, _HIDDEN)
+    mod.conv_wm_to_marlin_t(wm.w2, wm.s2, sc.w2, sc.s2.view(torch.uint8), _HIDDEN, _INTER)
+    return sc.w13, sc.s13, wm.gs13_marlin, sc.w2, sc.s2, wm.gs2_marlin
+
+
+def expert_outputs(wm: WmExperts, hidden_states: torch.Tensor, topk_ids: torch.Tensor, local_start: int):
+    """Routed experts for up to WM_MAX_TOKENS tokens.  Returns (y [m, top_k, H] bf16 with unspecified rows for routes
+    outside this GPU, local expert id per route (-1 outside) [m, top_k] int32)."""
+    global _empty_i32
+    mod = _get_module()
+    x = hidden_states.contiguous()
+    m = x.shape[0]
+    dev = x.device
+    if m == 0:
+        return x.new_empty((0, _TOP_K, _HIDDEN)), torch.empty((0, _TOP_K), dtype=torch.int32, device=dev)
+    if _empty_i32 is None or _empty_i32.device != dev:
+        _empty_i32 = torch.empty(0, dtype=torch.int32, device=dev)
+    nt, nw, ring, nch = _cfg(m)
+    lmax = (m + 7) // 8 * 8
+    ids = topk_ids.to(torch.int32).contiguous()
+    cnt = torch.empty(_NUM_LOCAL, dtype=torch.int32, device=dev)
+    lst = torch.empty(_NUM_LOCAL * lmax, dtype=torch.int32, device=dev)
+    act = torch.empty(4 * (_NUM_LOCAL + (m * _TOP_K) // (nch * 8) + 8), dtype=torch.int32, device=dev)
+    woff = torch.empty(128, dtype=torch.int32, device=dev)
+    nact = torch.empty(1, dtype=torch.int32, device=dev)
+    lids = torch.empty(m * _TOP_K, dtype=torch.int32, device=dev)
+    mod.wm_route(ids, _empty_i32, local_start, lmax, cnt, lst, act, nact, lids, woff, nch * 8)
+    maxslots = min(m * _TOP_K, _NUM_LOCAL + (m * _TOP_K) // (nch * 8))
+    inter = torch.empty((m * _TOP_K, _INTER), dtype=torch.bfloat16, device=dev)
+    y = torch.empty((m * _TOP_K, _HIDDEN), dtype=torch.bfloat16, device=dev)
+    if ring == 7:  # wgmma path reads its activations in fragment order (the first GEMM writes `inter` that way itself)
+        xp = torch.empty_like(x)
+        mod.wm_permx(x, xp)
+        x = xp
+    mod.wm_gemm_run(0, nch, nt, nw, ring, 0, wm.w13, wm.s13, wm.gs13, x, inter, cnt, lst, act, nact, woff, maxslots, lmax)
+    mod.wm_gemm_run(1, nch, nt, nw, ring, 0, wm.w2, wm.s2, wm.gs2, inter, y, cnt, lst, act, nact, woff, maxslots, lmax)
+    return y.view(m, _TOP_K, _HIDDEN), lids.view(m, _TOP_K)
